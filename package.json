{
  "name": "smart-accounting-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:ci": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:ci": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:ci": "vitest run",
    "coverage": "vitest run --coverage --reporter=basic",
    "compose:validate": "powershell -NoProfile -File scripts/validate-compose.ps1 -FilePath docker-compose.yml",
    "compose:validate:prod": "powershell -NoProfile -File scripts/validate-compose.ps1 -FilePath docker-compose.prod.yml",
    "release:check": "node scripts/release-freeze-guard.js --verify-policy",
    "audit:dependencies": "npm audit --audit-level=high",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
