# ==============================================================================
# SmartAccountingAI — Production Environment Template
# ==============================================================================
# CRITICAL NOTICE:
# This file is an example template for documentation only.
# It is NOT a deployable secret file.
# NEVER store real secrets in version control or copy this file directly to .env.
# Store all production secrets in a dedicated, secure secret manager (e.g. AWS
# Secrets Manager, HashiCorp Vault, Doppler, or platform environment variables).
# Production Compose and application startup fail closed if required secrets are missing.
# ==============================================================================

# --- DATABASE CONFIGURATION (Required) ---
# Database name for PostgreSQL
POSTGRES_DB=<your_production_db_name>

# PostgreSQL master user
POSTGRES_USER=<your_production_db_username>

# Strong, high-entropy password (min 24 characters recommended)
POSTGRES_PASSWORD=<generate_strong_unique_random_password>

# Application connection string matching the database credentials above
# Format: postgresql://<user>:<password>@postgres:5432/<dbname>?schema=public
# Ensure special characters in password are URL-encoded.
DATABASE_URL=postgresql://<your_production_db_username>:<url_encoded_password>@postgres:5432/<your_production_db_name>?schema=public

# --- AUTHENTICATION & SECURITY (Required) ---
# Public canonical URL where the web application is served
NEXTAUTH_URL=https://accounting.example.com

# High-entropy random secret for session encryption and JWT signing (min 32 characters)
# Generate via: openssl rand -base64 32
AUTH_SECRET=<generate_high_entropy_32_plus_char_secret>

# --- REDIS / RATE LIMITING (Required) ---
# Secret token for the internal serverless Redis HTTP proxy (SRH)
# Generate via: openssl rand -hex 24
REDIS_HTTP_TOKEN=<generate_long_random_hex_token>

# --- OPTIONAL AI & INFERENCE PROVIDERS ---
# Configure only authorized LLM providers permitted to handle sensitive accounting data
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Optional local/containerized model gateway
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# DOCUMENT_PROCESSOR_PROVIDER=
# DOCUMENT_PROCESSOR_MODEL=
