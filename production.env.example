# Never commit production values. Store them in your deployment secret manager.
POSTGRES_DB=smartaccountingai
POSTGRES_USER=smartaccountingai
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://smartaccountingai:replace-with-url-encoded-password@postgres:5432/smartaccountingai?schema=public
NEXTAUTH_URL=https://accounting.example.com
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
REDIS_HTTP_TOKEN=replace-with-a-long-random-token

# Optional AI providers. Configure only approved providers for financial data.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENAI_API_KEY=
